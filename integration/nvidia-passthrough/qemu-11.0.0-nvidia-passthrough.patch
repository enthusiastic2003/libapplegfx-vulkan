+static bool vfio_pci_bars_have_final_addresses(PCIDevice *pdev)
+{
+    int bar;
+
+    for (bar = 0; bar < PCI_ROM_SLOT; bar++) {
+        PCIIORegion *region = &pdev->io_regions[bar];
+        uint64_t base, probe;
+
+        if (!region->size) {
+            continue;
+        }
+        base = pci_get_long(pdev->config + PCI_BASE_ADDRESS_0 + bar * 4);
+        if (!(region->type & PCI_BASE_ADDRESS_SPACE_IO) &&
+            (region->type & PCI_BASE_ADDRESS_MEM_TYPE_MASK) ==
+             PCI_BASE_ADDRESS_MEM_TYPE_64) {
+            base |= (uint64_t)pci_get_long(pdev->config +
+                                           PCI_BASE_ADDRESS_0 +
+                                           (bar + 1) * 4) << 32;
+            base &= ~0xFULL;
+            probe = ~(region->size - 1) & ~0xFULL;
+            bar++;
+        } else if (region->type & PCI_BASE_ADDRESS_SPACE_IO) {
+            probe = ~(region->size - 1) & PCI_BASE_ADDRESS_IO_MASK;
+            base &= PCI_BASE_ADDRESS_IO_MASK;
+        } else {
+            probe = ~(region->size - 1) & PCI_BASE_ADDRESS_MEM_MASK;
+            base &= PCI_BASE_ADDRESS_MEM_MASK;
+            probe &= UINT32_MAX;
+        }
+        if (!base || base == probe) {
+            return false;
+        }
+    }
+    return true;
+}
