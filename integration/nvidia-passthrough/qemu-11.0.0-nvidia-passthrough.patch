+                 "cfg=%08x/%08x:%08x/%08x:%08x/%08x "
+                 "map=%"PRIx64"/%"PRIx64"/%"PRIx64"/%"PRIx64,
+                 vdev->vbasedev.name,
+                 pci_get_word(pdev->config + PCI_COMMAND), pdev->enabled,
+                 pdev->pm_cap ?
