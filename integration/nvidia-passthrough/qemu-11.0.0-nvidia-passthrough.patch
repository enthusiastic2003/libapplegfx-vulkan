+        val |= pci_get_word(d->config + PCI_COMMAND) &
+               (PCI_COMMAND_IO | PCI_COMMAND_MEMORY);
+    }
+
+    gen_rp_parent_config_write(d, address, val, len);
+
+    if (grp->preserve_fw_resources && !grp->fw_resources_locked &&
+        (pci_get_word(d->config + PCI_COMMAND) & PCI_COMMAND_MEMORY) &&
+        pci_get_long(d->config + PCI_PREF_BASE_UPPER32) != UINT32_MAX &&
+        pci_get_long(d->config + PCI_PREF_LIMIT_UPPER32) != 0) {
+        grp->fw_resources_locked = true;
+    }
