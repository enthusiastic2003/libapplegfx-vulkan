+    vdev->fw_resource_reset = false;
+    if (!vdev->fw_resources_locked) {
+        return;
+    }
+
+    for (bar = 0; bar < PCI_ROM_SLOT; bar++) {
+        pci_default_write_config(pdev, PCI_BASE_ADDRESS_0 + bar * 4,
+                                 vdev->fw_resource_bars[bar], 4);
+    }
+    vfio_pci_write_config(pdev, PCI_COMMAND,
+                          pci_get_word(pdev->config + PCI_COMMAND) |
+                          vdev->fw_resource_command, 2);
